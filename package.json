{
  "name": "wereldreis-dashboard",
  "private": true,
  "version": "2.19.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "audit:excel": "node --import tsx scripts/audit-excel-import.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:imports && npm run audit:buttons && npm run verify:release && npm run typecheck && npm run build",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "test:imports": "npm run test:excel",
    "test:excel": "node --import tsx scripts/test-excel-import.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  }
}
